{
  "name": "llm-router-docker",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @llm-router/server dev\" \"pnpm --filter @llm-router/web dev\"",
    "dev:server": "pnpm --filter @llm-router/server dev",
    "dev:web": "pnpm --filter @llm-router/web dev",
    "build": "pnpm -r build",
    "docker:build": "docker build -t llm-router-docker:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "docker:export": "docker save -o llm-router-docker-latest.tar llm-router-docker:latest",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
