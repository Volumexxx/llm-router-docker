NODE_ENV=production
HOST=0.0.0.0
PORT=4000
DATA_DIR=/data
TIMEZONE=Asia/Shanghai

# Required on first startup
CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_GATEWAY_API_KEY=replace-with-a-strong-gateway-key

# Reverse proxy / public base URL
TRUST_PROXY=true
EXTERNAL_BASE_URL=https://llm.example.com
ADMIN_EXTERNAL_BASE_URL=https://llm.example.com/admin

# Request and security settings
MAX_REQUEST_BODY_SIZE_MB=50
REQUEST_TIMEOUT_MS=120000
UPSTREAM_TIMEOUT_MS=120000
PROVIDER_TEST_DEFAULT_TIMEOUT_MS=10000
SESSION_TTL_HOURS=336
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
MAX_ACTIVE_PROXY_REQUESTS=100

# Optional CIDR allowlists
ADMIN_CIDR_WHITELIST=
API_CIDR_WHITELIST=
